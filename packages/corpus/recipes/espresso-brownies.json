{
  "id": "espresso-brownies",
  "title": "Espresso Brownies",
  "source": { "name": "Cooking For Engineers" },
  "components": [
    {
      "id": "brownies",
      "prelude": [
        { "id": "p-pan", "text": "Butter and flour an 8x8-in pan", "equipment": ["8x8-in pan"] },
        {
          "id": "p-oven",
          "text": "Preheat oven to 350°F (170°C)",
          "temperature": { "f": 350, "c": 170 },
          "equipment": ["oven"]
        }
      ],
      "ingredients": [
        {
          "id": "butter",
          "quantity": { "amount": 4, "unit": "oz", "metric": { "amount": 115, "unit": "g" } },
          "item": "unsalted butter"
        },
        {
          "id": "sugar",
          "quantity": { "amount": 1, "unit": "cup", "metric": { "amount": 200, "unit": "g" } },
          "item": "sugar"
        },
        {
          "id": "vanilla",
          "quantity": {
            "amount": "1/4",
            "unit": "tsp",
            "metric": { "amount": "2-1/2", "unit": "mL" }
          },
          "item": "vanilla extract"
        },
        {
          "id": "espresso",
          "quantity": { "amount": 4, "unit": "Tbs", "metric": { "amount": 60, "unit": "mL" } },
          "item": "fresh brewed espresso or very strong coffee",
          "note": "1 shot"
        },
        {
          "id": "eggs",
          "quantity": { "amount": 2, "unit": "count", "metric": { "amount": 100, "unit": "g" } },
          "item": "large eggs"
        },
        {
          "id": "flour",
          "quantity": { "amount": "1/2", "unit": "cup", "metric": { "amount": 80, "unit": "g" } },
          "item": "all-purpose flour"
        },
        {
          "id": "cocoa",
          "quantity": { "amount": "1/3", "unit": "cup", "metric": { "amount": 80, "unit": "g" } },
          "item": "Hershey's cocoa powder"
        },
        {
          "id": "baking-soda",
          "quantity": { "amount": "1/4", "unit": "tsp", "metric": { "amount": 1.3, "unit": "g" } },
          "item": "baking soda"
        },
        {
          "id": "salt",
          "quantity": {
            "amount": "1/4",
            "unit": "tsp",
            "metric": { "amount": "1-1/2", "unit": "g" }
          },
          "item": "table salt"
        }
      ],
      "root": "bake",
      "steps": {
        "melt": {
          "id": "melt",
          "inputs": ["butter"],
          "text": "melt",
          "effort": "quick",
          "technique": "melt"
        },
        "mix-wet": {
          "id": "mix-wet",
          "inputs": ["melt", "sugar", "vanilla", "espresso"],
          "text": "mix",
          "outputName": "the wet mixture",
          "effort": "quick",
          "technique": "mix"
        },
        "mix-eggs": {
          "id": "mix-eggs",
          "inputs": ["mix-wet", "eggs"],
          "text": "mix",
          "outputName": "the batter base",
          "effort": "quick",
          "technique": "mix"
        },
        "fold-in": {
          "id": "fold-in",
          "inputs": ["mix-eggs", "flour", "cocoa", "baking-soda", "salt"],
          "text": "fold in",
          "outputName": "the brownie batter",
          "effort": "minutes",
          "technique": "fold"
        },
        "bake": {
          "id": "bake",
          "inputs": ["fold-in"],
          "text": "bake 350°F (170°C) 30 to 40 min",
          "effort": "long-unattended",
          "duration": { "min": 30, "max": 40, "unit": "min" },
          "temperature": { "f": 350, "c": 170 },
          "technique": "bake",
          "equipment": ["oven", "8x8-in pan"]
        }
      }
    }
  ]
}
