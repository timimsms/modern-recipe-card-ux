          "note": "drained, rinsed"
        },
        { "id": "heavy-cream", "quantity": { "amount": 1, "unit": "cup" }, "item": "heavy cream" },
        {
          "id": "nutmeg",
          "quantity": { "unit": "pinch", "approximate": true },
          "item": "ground nutmeg",
          "note": "large"
        },
        {
          "id": "parmesan",
          "quantity": { "amount": "1/2", "unit": "cup" },
          "item": "shredded parmesan cheese"
        },
        {
          "id": "lemon-zest",
          "quantity": { "amount": "1/2", "unit": "tsp" },
          "item": "grated lemon zest"
        },
        {
          "id": "lemon-juice",
          "quantity": { "amount": 1, "unit": "tsp" },
          "item": "fresh lemon juice"
        }
      ],
      "root": "finish",
      "steps": {
        "heat-fat": {
          "id": "heat-fat",
          "inputs": ["olive-oil", "butter"],
          "text": "heat on med til butter melts",
          "effort": "quick",
          "temperature": { "label": "medium" },
          "technique": "melt"
        },
        "aromatics": {
          "id": "aromatics",
          "inputs": ["heat-fat", "shallot", "garlic", "capers", "red-pepper-flakes"],
