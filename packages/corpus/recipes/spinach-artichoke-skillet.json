        { "id": "butter", "quantity": { "amount": 1, "unit": "Tbs" }, "item": "unsalted butter" },
        {
          "id": "shallot",
          "quantity": { "amount": 1, "unit": "count" },
          "item": "large shallot",
          "note": "thinly sliced"
        },
        {
          "id": "garlic",
          "quantity": { "amount": 5, "unit": "count" },
          "item": "large garlic cloves",
          "note": "thiny sliced"
        },
        { "id": "capers", "quantity": { "amount": 1, "unit": "tsp" }, "item": "drained capers" },
        {
          "id": "red-pepper-flakes",
          "quantity": { "amount": "1/4", "unit": "tsp" },
          "item": "crushed red pepper flakes"
        },
        {
