          "effort": "minutes",
          "duration": { "min": 5, "max": 7, "unit": "min" },
          "technique": "saute"
        },
        "artichokes": {
          "id": "artichokes",
          "inputs": ["aromatics", "artichoke-hearts", "kosher-salt", "black-pepper"],
          "text": "3 min",
          "effort": "minutes",
          "duration": { "min": 3, "unit": "min" },
          "technique": "saute"
        },
        "wilt-spinach": {
          "id": "wilt-spinach",
          "inputs": ["artichokes", "spinach"],
          "text": "1 min",
          "effort": "quick",
          "duration": { "min": 1, "unit": "min" }
        },
        "simmer-sauce": {
          "id": "simmer-sauce",
          "inputs": ["wilt-spinach", "cannellini-beans", "heavy-cream", "nutmeg"],
          "text": "reduce to med low\n\nbring to a simmer\n\nstir occasionally until sauce is reduced and glossy (10 to 12 min)",
          "effort": "minutes",
          "duration": { "min": 10, "max": 12, "unit": "min" },
          "temperature": { "label": "medium low" },
          "technique": "simmer"
        },
        "finish": {
          "id": "finish",
          "inputs": ["simmer-sauce", "parmesan", "lemon-zest", "lemon-juice"],
          "text": "remove from heat and stir",
          "effort": "quick",
          "technique": "mix"
        }
